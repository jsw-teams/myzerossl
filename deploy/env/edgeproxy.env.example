EDGE_LISTEN=:443,:2053,:2083,:2087,:2096,:8443
EDGE_BACKEND=http://127.0.0.1:8080
EDGE_CERT=/etc/myzerossl/certs/example.com.fullchain.crt
# Optional multi-certificate mode. Entries are comma-separated; use key_id=path
# when the signer should use a named private key from clients.json.
# EDGE_CERTS=/etc/myzerossl/certs/example.com.fullchain.crt#,alt=/etc/myzerossl/certs/alternate.example.net.fullchain.pem
KEYLESS_TOKEN_FILE=/var/lib/memecdn/keyless.token
EDGE_CACHE_TTL=10m
EDGE_CACHE_MAX_BYTES=67108864
EDGE_CACHE_MAX_OBJECT_BYTES=4194304

# Optional zero-SSH enrollment. If KEYLESS_TOKEN and KEYLESS_TOKEN_FILE are
# empty, edgeproxy registers itself, waits for console approval, fetches the
# signer token over HTTPS, stores it in KEYLESS_TOKEN_FILE, then verifies it by
# connecting to KEYLESS_URL.
EDGE_REGISTER_URL=https://ssl-signer.js.gripe
EDGE_REGISTER_ID=tw-edge
EDGE_REGISTER_LABEL=Taiwan edge
EDGE_REGISTER_TOKEN=
EDGE_REGISTER_POLL=10s

KEYLESS_URL=https://10.0.0.10:9443
KEYLESS_CLIENT_ID=tw-edge
KEYLESS_CA=/etc/myzerossl/keyless/ca.crt
KEYLESS_CLIENT_CERT=/etc/myzerossl/keyless/edge-client.crt
KEYLESS_CLIENT_KEY=/etc/myzerossl/keyless/edge-client.key
KEYLESS_TOKEN=
