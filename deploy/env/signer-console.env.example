CONSOLE_LISTEN=127.0.0.1:19444
CONSOLE_ACCOUNT_API=https://gateway.js.gripe/api/v1/myaccount
CONSOLE_ACCOUNT_LOGIN=https://account.js.gripe/login
CONSOLE_PUBLIC_URL=https://ssl-signer.js.gripe
CONSOLE_CLIENT_ID=replace-with-account-system-client-id
CONSOLE_SESSION_SECRET=replace-with-a-long-random-secret
KEYLESS_CLIENTS=/etc/myzerossl/clients.json
KEYLESS_REVOKED=/etc/myzerossl/revoked-clients.txt
KEYLESS_AUDIT=/var/log/myzerossl/signer-audit.jsonl
