[Unit]
Description=memecdn low-trust edge CDN proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=myzerossl
Group=myzerossl
EnvironmentFile=/etc/myzerossl/edgeproxy.env
ExecStart=/usr/local/bin/edgeproxy
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/myzerossl
ReadOnlyPaths=/etc/myzerossl
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
