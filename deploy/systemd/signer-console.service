[Unit]
Description=memecdn signer admin console
After=network.target

[Service]
Type=simple
User=myzerossl
Group=myzerossl
EnvironmentFile=/etc/myzerossl/signer-console.env
ExecStart=/usr/local/bin/signer-console
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/myzerossl /var/log/myzerossl

[Install]
WantedBy=multi-user.target
